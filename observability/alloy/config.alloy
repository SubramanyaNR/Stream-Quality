discovery.docker "sq" { host = "unix:///var/run/docker.sock" }
discovery.relabel "sq" {
  targets = discovery.docker.sq.targets
  rule { source_labels = ["__meta_docker_container_name"] regex = "/(sq-.*)" target_label = "container" }
  rule { source_labels = ["__meta_docker_container_label_com_docker_compose_service"] target_label = "service" }
}
loki.source.docker "sq" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.sq.output
  forward_to = [loki.write.default.receiver]
}
loki.write "default" { endpoint { url = "http://loki:3100/loki/api/v1/push" } }
