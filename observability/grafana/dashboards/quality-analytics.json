    {
      "id": 13,
      "title": "Correlated failures",
      "type": "table",
      "description": "Windows where two or more different checks broke on the same topic at once: usually one upstream cause.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", topic, string_agg(DISTINCT check_type, ', ' ORDER BY check_type) AS failing_checks, count(DISTINCT check_type) AS n_checks FROM sq.check_results WHERE $__timeFilter(window_start) AND topic IN (${topic:singlequote}) AND status <> 'ok' GROUP BY window_start, topic HAVING count(DISTINCT check_type) >= 2 ORDER BY 1 DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
