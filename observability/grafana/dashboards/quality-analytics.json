            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Incident log",
      "type": "table",
      "description": "One row per incident (consecutive unhealthy windows of one check; a gap of > 3 window lengths ends an incident).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
