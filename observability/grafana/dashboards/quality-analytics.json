          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT topic, check_type, field, count(*) FILTER (WHERE flipped) AS flips, count(*) AS windows, round(100.0 * count(*) FILTER (WHERE flipped) / count(*), 1) AS flip_pct FROM (SELECT topic, check_type, field, ((status = 'ok') <> (lag(status) OVER w = 'ok')) AS flipped FROM sq.check_results WHERE $__timeFilter(window_start) AND topic IN (${topic:singlequote}) WINDOW w AS (PARTITION BY topic, check_type, field ORDER BY window_start)) s GROUP BY 1, 2, 3 HAVING count(*) FILTER (WHERE flipped) > 0 ORDER BY flips DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Worst null-rate fields",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 8,
