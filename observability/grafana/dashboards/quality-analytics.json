          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', window_start) AS \"time\", topic AS metric, avg(value) AS msgs_per_s FROM sq.check_results WHERE check_type = 'volume' AND $__timeFilter(window_start) AND topic IN (${topic:singlequote}) GROUP BY 1, 2 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', window_start) + interval '7 days' AS \"time\", topic || ' (7d ago)' AS metric, avg(value) AS msgs_per_s FROM sq.check_results WHERE check_type = 'volume' AND topic IN (${topic:singlequote}) AND window_start >= $__timeFrom()::timestamptz - interval '7 days' AND window_start <= $__timeTo()::timestamptz - interval '7 days' GROUP BY 1, 2 ORDER BY 1"
