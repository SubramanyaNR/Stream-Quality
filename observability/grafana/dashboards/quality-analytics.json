          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT topic, field, round((100 * avg(value))::numeric, 2) AS avg_null_pct, round((100 * max(value))::numeric, 2) AS max_null_pct, count(*) FILTER (WHERE status <> 'ok') AS bad_windows, count(*) AS windows FROM sq.check_results WHERE $__timeFilter(window_start) AND topic IN (${topic:singlequote}) AND check_type = 'null_rate' GROUP BY 1, 2 ORDER BY avg_null_pct DESC LIMIT 15"
