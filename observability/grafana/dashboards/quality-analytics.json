            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(window_start, $__interval), topic AS metric, round((100 * avg(CASE status WHEN 'ok' THEN 1.0 WHEN 'warn' THEN 0.5 ELSE 0.0 END))::numeric, 2) AS score FROM sq.check_results WHERE $__timeFilter(window_start) AND topic IN (${topic:singlequote}) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
