    {
      "id": 2,
      "title": "Topics failing",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sq-ch"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sq-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countDistinct(topic) AS failing FROM sq.latest_status FINAL WHERE status = 'fail' AND window_end > now64(3) - INTERVAL 5 MINUTE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Topics warning",
      "type": "stat",
      "description": "",
      "datasource": {
