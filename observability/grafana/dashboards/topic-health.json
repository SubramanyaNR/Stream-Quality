              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Monitor heartbeat age (s)",
      "type": "stat",
      "description": "Seconds since the Flink job last wrote a heartbeat.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sq-ch"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sq-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dateDiff('second', max(ts), now64(3)) AS age_s FROM sq.job_heartbeat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Kafka reachable",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sq-ch"
      },
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sq-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(kafka_status, ts) AS kafka FROM sq.job_heartbeat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "up": {
                  "text": "UP",
                  "color": "green"
                },
                "down": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Registry",
      "type": "stat",
      "description": "disabled / up / down. When down, structural checks are skipped; statistical checks continue.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sq-ch"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sq-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(registry_status, ts) AS registry FROM sq.job_heartbeat"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "up": {
                  "text": "UP",
                  "color": "green"
                },
                "disabled": {
                  "text": "DISABLED",
                  "color": "text"
                },
                "down": {
                  "text": "DOWN (structural skipped)",
                  "color": "orange"
                },
                "unknown": {
                  "text": "UNKNOWN",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Violations per minute by check type",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sq-ch"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sq-ch"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(window_end, INTERVAL 1 MINUTE) AS time, check_type, count() AS violations FROM sq.violations FINAL WHERE $__timeFilter(window_end) GROUP BY time, check_type ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
