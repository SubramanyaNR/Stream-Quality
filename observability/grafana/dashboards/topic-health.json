    {
      "id": 2,
      "title": "Topics failing",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
