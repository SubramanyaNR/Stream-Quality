    {
      "id": 1,
      "title": "Topic health (latest window per check)",
      "type": "table",
      "description": "Worst status across fields for each check type, from the latest window. 'no data' = no result in the last 5 minutes (check not configured for the topic, or the topic/monitor is silent). Click a topic to drill down.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT topic, max(status_n) FILTER (WHERE check_type = 'volume') AS volume, max(status_n) FILTER (WHERE check_type = 'null_rate') AS null_rate, max(status_n) FILTER (WHERE check_type = 'cardinality') AS cardinality, max(status_n) FILTER (WHERE check_type = 'freshness') AS freshness, max(status_n) FILTER (WHERE check_type = 'structural') AS structural, max(window_end) AS last_window FROM (SELECT topic, check_type, CASE status WHEN 'ok' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END AS status_n, window_end FROM sq.latest_status WHERE window_end > now() - interval '5 minutes') s GROUP BY topic ORDER BY topic"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "rgba(31,169,113,0.14)",
                        "index": 0
                      },
                      "1": {
                        "text": "WARN",
                        "color": "rgba(240,163,58,0.20)",
                        "index": 1
                      },
                      "2": {
                        "text": "FAIL",
                        "color": "rgba(229,72,77,0.16)",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "no data",
                        "color": "#F1EEFB",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
