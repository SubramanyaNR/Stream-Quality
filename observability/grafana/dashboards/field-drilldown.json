    {
      "id": 5,
      "title": "Status timeline (all checks for selected topic/fields)",
      "type": "state-timeline",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", check_type || CASE WHEN field = '' THEN '' ELSE '.' || field END AS metric, CASE status WHEN 'ok' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END AS status FROM sq.check_results WHERE $__timeFilter(window_start) AND topic IN (${topic:singlequote}) AND (field = '' OR field IN (${field:singlequote})) ORDER BY 1"
        }
      ],
