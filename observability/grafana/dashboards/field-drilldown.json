    {
      "id": 1,
      "title": "Null rate per field",
      "type": "timeseries",
      "description": "Fraction of records where the field is null/missing. Dashed = threshold that was crossed (shown only while violating).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", field AS metric, value AS null_rate FROM sq.check_results WHERE $__timeFilter(window_start) AND check_type = 'null_rate' AND topic IN (${topic:singlequote}) AND field IN (${field:singlequote}) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", field || ' threshold' AS metric, threshold FROM sq.check_results WHERE $__timeFilter(window_start) AND check_type = 'null_rate' AND topic IN (${topic:singlequote}) AND field IN (${field:singlequote}) AND status <> 'ok' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "shades",
            "fixedColor": "#7C5CFC"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 14,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(baseline|7d ago)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B7ADDF"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* threshold$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E5484D"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
