      }
    },
    {
      "id": 1,
      "title": "Violation audit log",
      "type": "table",
      "description": "Every warn/fail result, newest first (max 1000 rows in the selected range). `details` holds the check-specific JSON.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_end AS \"time\", topic, field, check_type, status::text AS status, round(value::numeric, 4) AS value, round(threshold::numeric, 4) AS threshold, details::text AS details FROM sq.violations WHERE $__timeFilter(window_end) AND topic IN (${topic:singlequote}) AND check_type IN (${check:singlequote}) AND status::text IN (${status:singlequote}) ORDER BY window_end DESC LIMIT 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fail": {
                        "text": "FAIL",
                        "color": "#E5484D",
                        "index": 0
                      },
                      "warn": {
                        "text": "WARN",
                        "color": "#F0A33A",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "details"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Violations over time",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(window_end, '1m'), status::text AS metric, count(*) AS n FROM sq.violations WHERE $__timeFilter(window_end) AND topic IN (${topic:singlequote}) AND check_type IN (${check:singlequote}) AND status::text IN (${status:singlequote}) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 85,
            "lineWidth": 0,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E5484D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F0A33A"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Top offenders",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT topic, field, check_type, count(*) FILTER (WHERE status = 'fail') AS fails, count(*) FILTER (WHERE status = 'warn') AS warns FROM sq.violations WHERE $__timeFilter(window_end) AND topic IN (${topic:singlequote}) AND check_type IN (${check:singlequote}) AND status::text IN (${status:singlequote}) GROUP BY topic, field, check_type ORDER BY fails DESC, warns DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Alert history",
      "type": "table",
      "description": "Every alert Alertmanager delivered (stored by the alert-sink in sq.alert_events). One row per alert instance: when it fired, when it resolved, how long it lasted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sq-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sq-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT fired_at AS \"time\", resolved_at, alertname, severity, topic, check_type, field, CASE WHEN firing THEN 'FIRING' ELSE 'resolved' END AS state, extract(epoch FROM duration)::int AS duration_s FROM sq.alert_history WHERE $__timeFilter(fired_at) AND (topic = '' OR topic IN (${topic:singlequote})) ORDER BY fired_at DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "FIRING": {
                        "text": "FIRING",
                        "color": "#E5484D",
                        "index": 0
                      },
                      "resolved": {
                        "text": "resolved",
                        "color": "#1FA971",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
