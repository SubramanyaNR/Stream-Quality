# cluster.env - the one file you edit. `make up` copies this to cluster.env on first run.
# Every script, the compose file and config/*.properties read from here.

# ---- Kafka ------------------------------------------------------------------
# Address the Flink containers use (the broker's advertised listener on that network).
KAFKA_BOOTSTRAP=kafka:29092
# Address you use from this host (CLI checks).
KAFKA_BOOTSTRAP_HOST=localhost:9092
# Docker network the Kafka containers live on. Use "bridge" if Kafka is not in Docker.
KAFKA_DOCKER_NETWORK=kafka-net
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Only needed when you enable a SASL block in config/kafka.properties.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TRUSTSTORE_PASSWORD=
# Image whose CLI is used by `make dlq` and `make check`.
KAFKA_CLI_IMAGE=apache/kafka:3.9.1

# ---- What to monitor ----------------------------------------------------------
# Regex over topic names (full match). Leave empty to use TOPICS or thresholds.yaml.
TOPICS_PATTERN=orders|payments
# Regex of topics to skip. The dead-letter topic is always skipped.
TOPICS_EXCLUDE=_.*
# Fixed list, used only when TOPICS_PATTERN is empty.
TOPICS=

# ---- Dead-letter topic --------------------------------------------------------
DLQ_TOPIC=sq.dead-letter
DLQ_PARTITIONS=3
DLQ_REPLICATION=1

# ---- Schema registry ----------------------------------------------------------
REGISTRY_ENABLED=false
REGISTRY_URL=http://host.docker.internal:8081/apis/registry/v3
REGISTRY_USER=
REGISTRY_PASSWORD=

# ---- Stack --------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
RESULTS_RETENTION_DAYS=90
HEARTBEAT_RETENTION_DAYS=14
