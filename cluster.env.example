# cluster.env - the one file you edit. `make up` copies this to cluster.env on first run.
# Every script, the compose file and config/*.properties read from here.

# ---- Kafka ------------------------------------------------------------------
# Address the Flink containers use (the broker's advertised listener on that network).
KAFKA_BOOTSTRAP=kafka:29092
# Address you use from this host (CLI checks).
KAFKA_BOOTSTRAP_HOST=localhost:9092
# Docker network the Kafka containers live on. Use "bridge" if Kafka is not in Docker.
KAFKA_DOCKER_NETWORK=kafka-net
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Only needed when you enable a SASL block in config/kafka.properties.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TRUSTSTORE_PASSWORD=
# Image whose CLI is used by `make dlq` and `make check`.
KAFKA_CLI_IMAGE=apache/kafka:3.9.1

# ---- What to monitor ----------------------------------------------------------
# Regex over topic names (full match). Leave empty to use TOPICS or thresholds.yaml.
TOPICS_PATTERN=orders|payments
# Regex of topics to skip. The dead-letter topic is always skipped.
TOPICS_EXCLUDE=_.*
# Fixed list, used only when TOPICS_PATTERN is empty.
TOPICS=

# ---- Dead-letter topic --------------------------------------------------------
DLQ_TOPIC=sq.dead-letter
DLQ_PARTITIONS=3
DLQ_REPLICATION=1

# ---- Schema registry ----------------------------------------------------------
REGISTRY_ENABLED=false
# apicurio  = Apicurio v3 native API        (URL like http://host:8080/apis/registry/v3)
# confluent | karapace | redpanda | ccompat = Confluent REST API: Confluent Schema Registry, Karapace, Redpanda, or Apicurio's
#             /apis/ccompat/v7 endpoint       (URL like http://schema-registry:8081). Supports JSON Schema, Avro and Protobuf (wire format).
REGISTRY_TYPE=apicurio
REGISTRY_URL=http://host.docker.internal:8081/apis/registry/v3
REGISTRY_USER=
REGISTRY_PASSWORD=

# ---- Stack --------------------------------------------------------------------
# Passwords: leave them EMPTY here. `make up` copies this file to cluster.env (git-ignored, chmod 600) and fills each
# empty password with a random value, so no two installs share credentials. To change one later: edit cluster.env, then
# `make migrate` (database roles) and `docker compose up -d` (containers).
POSTGRES_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
SQ_WRITER_PASSWORD=
SQ_READER_PASSWORD=
# Address the published ports (Grafana 3000, Postgres 5432, Prometheus 9090, Alertmanager 9093, alert-sink 5001) listen on.
# 127.0.0.1 = this machine only. Use 0.0.0.0 only behind a firewall/VPN or an authenticating reverse proxy.
SQ_BIND_ADDRESS=127.0.0.1
RESULTS_RETENTION_DAYS=30
HEARTBEAT_RETENTION_DAYS=14

# ---- How the Flink job runs ---------------------------------------------------------------------------------
# compact (default): the job embedded in one ~350 MB JVM. cluster: standalone JobManager + TaskManager containers
# (~1.3 GB, RocksDB state, scale out with parallelism). Switch with `COMPOSE_PROFILES`.
COMPOSE_PROFILES=compact
# Compact mode memory: JVM heap and the container limit (heap + metaspace + off-heap needs ~2x heap).
SQ_HEAP=256m
SQ_JOB_MEM_LIMIT=512m
